# STB RECHARGE Frontend Configuration Template
VITE_APP_TITLE=STB RECHARGE

# Set backend target URL for Vite dev proxy & API client
# Local Development: http://localhost:5000
# Render Production: https://stb-recharge-backend.onrender.com
VITE_BACKEND_TARGET=https://stb-recharge-backend.onrender.com
VITE_API_URL=https://stb-recharge-backend.onrender.com/api

# Firebase Authentication Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

